{
  "name": "cozy-language-village",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:single": "npm run build && node scripts/inline.mjs",
    "preview": "vite preview --host",
    "validate:towns": "esbuild tools/validate/towns.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/validate-towns.mjs --log-level=error && node node_modules/.cache/validate-towns.mjs",
    "voice:lines": "esbuild tools/voice/export-lines.ts --bundle --platform=node --format=esm --outfile=tools/voice/.export-lines.mjs --log-level=error && node tools/voice/.export-lines.mjs",
    "app:sync": "npm run build && cap sync",
    "app:android": "npm run app:sync && cap open android",
    "app:ios": "npm run app:sync && cap open ios",
    "app:assets": "capacitor-assets generate --iconBackgroundColor \"#FFF4E6\" --iconBackgroundColorDark \"#FFF4E6\" --splashBackgroundColor \"#FFF4E6\" --splashBackgroundColorDark \"#FFF4E6\""
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@revenuecat/purchases-capacitor": "^14.0.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
